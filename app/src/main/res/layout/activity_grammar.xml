<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/grammar_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brown_700">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/grammar_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/elevation_medium"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/grammar_analyzer" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_analyze_grammar"
        app:layout_constraintTop_toBottomOf="@+id/grammar_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_normal">

            <!-- Input Section -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/grammar_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/grammar_analyzer_hint"
                app:boxBackgroundMode="outline"
                app:hintTextColor="@color/brown_700"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/grammar_input_text"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@color/white"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLines="10"
                    android:textColor="@color/brown_800"
                    android:textColorHint="@color/brown_500"
                    android:textSize="@dimen/text_size_body_large" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Empty State -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grammar_empty_state"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/margin_large"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="@dimen/elevation_small"
                app:layout_constraintTop_toBottomOf="@+id/grammar_input_layout">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/empty_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analyze_your_tibetan"
                        android:textAlignment="center"
                        android:textColor="@color/brown_700"
                        android:textSize="@dimen/text_size_body_large"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Results List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grammar_corrections_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/padding_normal"
                app:layout_constraintTop_toBottomOf="@+id/grammar_input_layout" />

            <!-- Loading Animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/grammar_loading"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/margin_large"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/grammar_input_layout"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_animation" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Analyze Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_analyze_grammar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_normal"
        android:text="@string/analyze_grammar"
        android:textSize="@dimen/text_size_body_large"
        app:cornerRadius="@dimen/corner_xlarge"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
