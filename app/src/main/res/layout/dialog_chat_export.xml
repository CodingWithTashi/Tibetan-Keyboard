<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/export_conversation"
        android:textColor="@color/brown_800"
        android:textSize="@dimen/text_size_headline_small"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/choose_export_format"
        android:textColor="@color/gray"
        android:textSize="@dimen/text_size_body_medium" />

    <!-- Format Selection -->
    <RadioGroup
        android:id="@+id/export_format_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/format_pdf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_size"
            android:gravity="center_vertical"
            android:text="@string/format_pdf"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/format_txt"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_size"
            android:gravity="center_vertical"
            android:text="@string/format_txt"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/format_markdown"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_size"
            android:gravity="center_vertical"
            android:text="@string/format_markdown"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_medium" />

    </RadioGroup>

    <!-- Options -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/include_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/include_metadata"
        android:textColor="@color/brown_700"
        android:textSize="@dimen/text_size_body_small" />

    <!-- Export Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/export_now"
        android:textSize="@dimen/text_size_body_medium"
        app:cornerRadius="@dimen/corner_normal" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/cancel"
        android:textSize="@dimen/text_size_body_medium"
        app:cornerRadius="@dimen/corner_normal" />

</LinearLayout>
