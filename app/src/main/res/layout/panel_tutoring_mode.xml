<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/padding_normal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tutoring_mode_label"
            android:textColor="@color/brown_800"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_tutoring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Level Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/learning_level"
        android:textColor="@color/brown_700"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/level_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:enabled="false"
        android:orientation="horizontal">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/level_beginner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/level_beginner"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_small" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/level_intermediate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/level_intermediate"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_small" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/level_advanced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/level_advanced"
            android:textColor="@color/brown_700"
            android:textSize="@dimen/text_size_body_small" />

    </RadioGroup>

    <!-- Progress Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/progress"
        android:textColor="@color/brown_700"
        android:textSize="@dimen/text_size_body_small"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:layout_marginTop="@dimen/spacing_8"
        android:progress="25" />

    <TextView
        android:id="@+id/progress_percentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="25% Complete"
        android:textColor="@color/gray"
        android:textSize="@dimen/text_size_caption" />

    <!-- Current Lesson -->
    <TextView
        android:id="@+id/current_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/current_lesson"
        android:textColor="@color/brown_700"
        android:textSize="@dimen/text_size_body_small" />

</LinearLayout>
