<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF704C04">

    <!-- Single Gboard-style top bar — one fixed-height row holding BOTH the suggestion strip
         (the weighted middle) and the premium controls. Free users see the gold upsell pill +
         dimmed feature icons; PRO users see live suggestions + active Chat/Translate. The bar
         height never changes, so the keyboard never jumps as suggestions come and go.
         Visibility/dim of children is driven by premium state in AIKeyboardView.applyPremiumState(). -->
    <LinearLayout
        android:id="@+id/ai_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#FF704C04"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- Streak flame chip — the always-visible Journey trigger. Shown to everyone once a
             streak exists (GONE at 0 days); tap opens the Journey screen. Value is refreshed by
             AIKeyboardView.refreshStreakChip() on every keyboard open. -->
        <TextView
            android:id="@+id/streak_chip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/tk_gold"
            android:background="@drawable/tk_lang_pill"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/journey_streak_chip_cd"
            tools:text="🔥 12" />

        <!-- Gold upsell pill (free users only) -->
        <LinearLayout
            android:id="@+id/pro_pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/pro_pill_background"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_star_filled"
                android:layout_marginEnd="5dp"
                android:tint="#3A2606" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_pro"
                android:textColor="#3A2606"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Suggestion strip — the flexible middle of the bar. Always present (acts as the spacer
             that pushes the pill left and the icons right). Holds autocomplete chips for PRO users
             while typing; empty otherwise. Never toggles height, so the keyboard never jumps. -->
        <com.kharagedition.tibetankeyboard.ui.keyboard.SuggestionStripView
            android:id="@+id/suggestion_strip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- AI Chat -->
        <ImageView
            android:id="@+id/pro_chat_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/baseline_chat_24"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_ai_chat"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/tk_gold" />

        <!-- Autocomplete (free users only) -->
        <ImageView
            android:id="@+id/pro_auto_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_pro_autocomplete"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_autocomplete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/tk_gold" />

        <!-- Translate -->
        <ImageView
            android:id="@+id/pro_translate_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_pro_translate"
            android:scaleType="fitCenter"
            android:contentDescription="@string/translate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/tk_gold" />

    </LinearLayout>

    <!-- Main Keyboard Container - This will switch between normal keyboard and emoji keyboard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Normal Keyboard Container -->
        <FrameLayout
            android:id="@+id/normal_keyboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- Your existing keyboard view will be added here programmatically -->
        </FrameLayout>

        <!-- Emoji Keyboard Container (Initially Hidden) -->
        <FrameLayout
            android:id="@+id/emoji_keyboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <!-- Emoji keyboard will be added here programmatically -->
        </FrameLayout>

    </FrameLayout>

    <!-- AI Interface Container (Initially Hidden) — dark-warm translate/grammar/rephrase panel.
         Sticky header + scrollable body + sticky action bar. The PRO strip is hidden while this is
         open (AIKeyboardView.showAIInterface) so this is the single, cohesive surface. -->
    <LinearLayout
        android:id="@+id/ai_interface_container"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:orientation="vertical"
        android:background="@color/tk_bg_900"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- Sticky header (app-bar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/ai_back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:tint="@color/tk_cream" />

            <TextView
                android:id="@+id/ai_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Translate"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tk_cream"
                android:layout_marginStart="6dp" />

            <ProgressBar
                android:id="@+id/loading_progress_bar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                android:indeterminateTint="@color/tk_gold" />

            <Button
                android:id="@+id/ai_inner_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Retry"
                android:paddingHorizontal="14dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/tk_gold"
                android:background="@drawable/ai_cancel_button_background" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFCF5E8" />

        <!-- Scrollable body -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <!-- Translation engine selector (Only visible for translation) — on-theme
                     single-tap chips: Azure / Haiku / Sonnet. Selected = gold; styling is
                     driven from AIKeyboardView.styleEngineChips(). -->
                <LinearLayout
                    android:id="@+id/engine_selector_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/translate_engine_label"
                        android:textColor="@color/tk_cream_dim"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/engine_chip_azure"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/engine_azure"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tk_cream"
                        android:background="@drawable/tk_lang_pill"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/engine_chip_haiku"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/engine_haiku"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tk_cream"
                        android:background="@drawable/tk_lang_pill"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/engine_chip_sonnet"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/engine_sonnet"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tk_cream"
                        android:background="@drawable/tk_lang_pill"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Translation Language Controls (Only visible for translation) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/source_language_text"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="བོད་སྐད།"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tk_gold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:background="@drawable/tk_lang_pill"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/translate_swap_btn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="9dp"
                        android:layout_marginHorizontal="10dp"
                        android:src="@drawable/ic_swap_horiz"
                        android:background="@drawable/tk_swap_bg"
                        android:visibility="gone"
                        android:tint="@color/tk_gold" />

                    <TextView
                        android:id="@+id/target_language_text"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="English"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tk_gold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:background="@drawable/tk_lang_pill"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Original Text Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tk_translate_card"
                    android:padding="14dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_original"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/tk_cream_dim"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/original_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your original text will appear here..."
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/tk_cream"
                        android:textColorHighlight="#66F2C264"
                        android:textIsSelectable="true" />

                </LinearLayout>

                <!-- Suggested Text Section (highlighted result) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tk_translate_card_accent"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_suggested"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/tk_gold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/suggested_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Improved text will appear here..."
                        android:textSize="16sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/tk_cream"
                        android:textColorHighlight="#66F2C264"
                        android:textIsSelectable="true" />

                </LinearLayout>

                <!-- Summary Section -->
                <LinearLayout
                    android:id="@+id/ai_summary_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tk_translate_card"
                    android:padding="14dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/translate_summary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/tk_cream_dim"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/ai_summary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Analysis summary will appear here..."
                        android:textSize="13sp"
                        android:lineSpacingExtra="1dp"
                        android:textColor="@color/tk_cream_dim" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFCF5E8" />

        <!-- Sticky action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <Button
                android:id="@+id/ai_cancel_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="0dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/tk_cream_dim"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/ai_cancel_button_background"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/ai_replace_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:minHeight="0dp"
                android:layout_weight="1.5"
                android:text="Replace"
                android:textColor="#FF3A2606"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/ai_replace_button_background" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>