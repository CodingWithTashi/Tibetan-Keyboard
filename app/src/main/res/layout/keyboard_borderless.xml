<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless layout: glyphs only, no key boxes. Shared across all colour themes;
     the surface colour is applied at runtime by the IME. -->
<com.kharagedition.tibetankeyboard.ui.keyboard.TibetanKeyboardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keyboard"
    android:layout_alignParentBottom="true"
    tools:viewBindingIgnore="true"
    android:keyTextColor="@android:color/white"
    android:keyBackground="@drawable/key_background_borderless"
    android:keyPreviewLayout="@layout/key_preview"
    android:background="@color/keyboard_background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

</com.kharagedition.tibetankeyboard.ui.keyboard.TibetanKeyboardView>
