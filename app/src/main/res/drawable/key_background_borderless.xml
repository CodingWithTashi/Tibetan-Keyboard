<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless: no box/border at rest; only a soft highlight while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/pressed_borderless" />
    <item android:drawable="@android:color/transparent" />
</selector>
