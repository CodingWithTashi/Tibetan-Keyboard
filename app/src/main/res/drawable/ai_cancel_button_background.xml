<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary "ghost" button (Cancel) — transparent with a soft cream outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFCF5E8" />
            <stroke android:width="1dp" android:color="#80C7B284" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4DC7B284" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
