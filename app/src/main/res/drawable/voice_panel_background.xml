<?xml version="1.0" encoding="utf-8"?>
<!-- Voice panel surface: the AI panel's deep brown with a soft gold glow rising behind the mic. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tk_bg_900" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.9"
                android:gradientRadius="70%p"
                android:startColor="#1CF2C264"
                android:endColor="#00F2C264" />
        </shape>
    </item>
</layer-list>
