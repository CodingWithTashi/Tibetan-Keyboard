<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TibetanKeyboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:typeface">monospace</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brown_700</item>
        <item name="colorPrimaryVariant">@color/brown_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/yellow_700</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColorTertiary">@color/black</item>
    </style>
    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Login Button Style -->
    <style name="LoginButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Warm dark-warm Material alert dialog used by showConfirmationDialog. -->
    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/tk_brown_700</item>
        <item name="colorOnSurface">@color/tk_cream</item>
        <item name="colorPrimary">@color/tk_gold</item>
        <item name="android:textColorPrimary">@color/tk_cream</item>
        <item name="android:textColorSecondary">@color/tk_cream_dim</item>
        <item name="shapeAppearanceMediumComponent">@style/TkDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TkDialogTitle</item>
    </style>

    <style name="TkDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="TkDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/tk_cream</item>
        <item name="android:textStyle">bold</item>
    </style>

        <style name="SearchKeyStyle">
            <item name="android:layout_width">0dp</item>
            <item name="android:layout_height">match_parent</item>
            <item name="android:gravity">center</item>
            <item name="android:textColor">#FFFFFF</item>
            <item name="android:textSize">14sp</item>
            <item name="android:background">@drawable/search_key_background</item>
            <item name="android:layout_margin">1dp</item>
            <item name="android:clickable">true</item>
            <item name="android:focusable">true</item>
        </style>

</resources>